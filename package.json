{
  "name": "nexa-workforce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Nexa Workforce Solutions Ltd — Phase 1 production foundation: multi-tenant monorepo (Next.js web, NestJS API, FastAPI AI orchestration, Prisma/PostgreSQL with Row-Level Security).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm run db:generate --workspace=@nexa/database",
    "db:migrate": "npm run db:migrate --workspace=@nexa/database",
    "db:deploy": "npm run db:deploy --workspace=@nexa/database && npm run db:rls --workspace=@nexa/database",
    "db:rls": "npm run db:rls --workspace=@nexa/database",
    "db:seed": "npm run db:seed --workspace=@nexa/database"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
