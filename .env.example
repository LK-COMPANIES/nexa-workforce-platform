# =============================================================================
# Nexa Workforce Solutions — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# These defaults assume services run directly on the host with `docker
# compose up postgres redis` providing just the datastores; when running the
# full stack via `docker compose up`, docker-compose.yml overrides the
# handful of variables that must resolve to in-network service names
# (DATABASE_URL, DIRECT_DATABASE_URL, REDIS_URL, AI_SERVICE_URL,
# NEXT_PUBLIC_API_URL, API_INTERNAL_URL) — you do not need to change those
# here for the dockerized flow to work.
# =============================================================================

# ---- Application --------------------------------------------------------
NODE_ENV=development
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000

# ---- PostgreSQL -----------------------------------------------------------
# Owner/superuser credentials — used only for migrations (DIRECT_DATABASE_URL)
# and by packages/database/scripts/apply-rls.ts to provision the
# RLS-constrained runtime role below. The running application NEVER connects
# with these credentials.
POSTGRES_USER=nexa_owner
POSTGRES_PASSWORD=change_me_owner_password
POSTGRES_DB=nexa_workforce
POSTGRES_EXPOSED_PORT=5432

# Password for the `nexa_app` role that apps/api and apps/ai actually connect
# as (RLS-constrained, NOBYPASSRLS). Provisioned by `npm run db:rls`.
NEXA_APP_DB_PASSWORD=change_me_app_password

# Connection the running application uses for all normal request traffic
# (RLS-constrained nexa_app role).
DATABASE_URL=postgresql://nexa_app:change_me_app_password@localhost:5432/nexa_workforce?schema=public
# Privileged connection used ONLY for `prisma migrate deploy` and
# `db:rls` (owner role — bypasses RLS by virtue of being the table owner).
DIRECT_DATABASE_URL=postgresql://nexa_owner:change_me_owner_password@localhost:5432/nexa_workforce?schema=public

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_EXPOSED_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---- Authentication -----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
JWT_REFRESH_TTL=7d
JWT_ISSUER=nexa-workforce-platform
JWT_AUDIENCE=nexa-workforce-platform-clients

# Platform super-admin bootstrap (packages/database/prisma/seed.ts). Disabled
# by default. When enabled, both credential vars are REQUIRED — the password
# has no default and seeding fails loudly if it's missing. Never commit real
# values; unset AUTH_BOOTSTRAP_ENABLED (or leave it false) once the initial
# admin account has been created.
AUTH_BOOTSTRAP_ENABLED=false
NEXA_BOOTSTRAP_ADMIN_EMAIL=
NEXA_BOOTSTRAP_ADMIN_PASSWORD=

# Seed-safety confirmation required when NODE_ENV=production — see
# packages/database/prisma/seed.ts assertSafeToRun(). Irrelevant in development.
SEED_CONFIRM_PRODUCTION=false

# ---- Anthropic / AI orchestration (apps/ai) --------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CONTRACT_AUDIT=claude-sonnet-5
ANTHROPIC_MODEL_BPO_QA=claude-sonnet-5
AI_PORT=8000

# Must match apps/api's JWT_ISSUER / JWT_AUDIENCE above exactly — apps/ai
# verifies the same tokens apps/api issues, using its own explicitly-named
# vars (see apps/ai/app/config.py) rather than silently reusing JWT_ISSUER/
# JWT_AUDIENCE, so the trust boundary between the two services is visible
# in configuration, not just in code.
AI_JWT_ISSUER=nexa-workforce-platform
AI_JWT_AUDIENCE=nexa-workforce-platform-clients

# Wall-clock budget (seconds) for a single Anthropic call before the AI job
# is failed rather than left hanging.
AI_REQUEST_TIMEOUT=45

# Hard ceiling, in bytes, on an AI agent request body (e.g. a BPO QA
# transcript) — rejected with 413 before it reaches Claude.
AI_MAX_INPUT_SIZE=50000

# "<requests>/<window_seconds>" — Redis-backed, per-organization.
AI_RATE_LIMIT=20/60

# ---- Object storage (S3-compatible) --------------------------------------
STORAGE_PROVIDER=s3
STORAGE_BUCKET=nexa-workforce-documents
STORAGE_REGION=af-south-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# ---- Observability --------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Next.js (apps/web) ----------------------------------------------------
# Browser-facing — inlined into the client bundle. Must be reachable from
# wherever the browser runs (the host), never a Docker-internal hostname.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only — how the web server process itself reaches the API. Optional
# for host-based dev (falls back to NEXT_PUBLIC_API_URL); required inside
# docker-compose, where it's set automatically to http://api:4000.
API_INTERNAL_URL=http://localhost:4000

# ---- Website (apps/website) — public marketing site -----------------------
# Independent of every other app: no @nexa/* package dependency, no
# database, no auth (see apps/website/package.json). Optional — only
# affects generated canonical URLs (sitemap.xml, robots.txt, Open Graph
# metadata); the site works without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---- Service ports (docker-compose) ---------------------------------------
WEB_PORT=3000
API_PORT=4000
WEBSITE_PORT=3100
